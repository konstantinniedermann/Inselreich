        h("spawned", "06:31", "g-lt", child_id="g-qr", tool_use_id="g5"),
        h("agent_start", "06:32", "g-qr", role="qa-code-reviewer", status="active"),
        *beats("g-qr", "06:40", "08:50", 30, ["Read", "Grep"]),
